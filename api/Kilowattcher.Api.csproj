<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7ac7ace1-a310-4674-a03a-f933ba5bcc9e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Precomputed vectors ship with the app so cold starts make zero embedding calls. -->
    <Content Update="Data\embeddings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The source docs are only needed by tools/embed, not at runtime. -->
    <None Update="Data\docs\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kilowattcher.Api.Tests" />
  </ItemGroup>

</Project>
