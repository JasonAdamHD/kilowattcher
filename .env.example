# Kilowattcher environment variables: names and FAKE placeholder values only.
# Never put real values in this file. Real values live in:
#   local dev  -> dotnet user-secrets (outside the repo folder)
#   production -> Vercel environment variables (Sensitive where marked)
#   CI evals   -> GitHub Actions secrets
# See docs/CONFIG.md (private, local only) for what each variable does.

# Base URL of the Foundry resource (Sensitive)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Key 1 or key 2 of the resource (Sensitive)
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key

# Deployment name of the chat model
AZURE_OPENAI_CHAT_DEPLOYMENT=chat

# Deployment name of the embedding model
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embed

# Uppercase hex SHA-256 of the invite code (Sensitive)
INVITE_CODE_HASH=REPLACE_WITH_UPPERCASE_HEX_SHA256_OF_INVITE_CODE

# Base64 of 32 random bytes; signs the session cookie (Sensitive)
SESSION_SIGNING_KEY=replace-with-base64-of-32-random-bytes

# Port Kestrel binds (not secret)
PORT=8080
